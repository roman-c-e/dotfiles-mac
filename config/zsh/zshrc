# Shared interactive shell setup for local and remote development.
export ZSH="$HOME/.config/zsh"
export PERSONAL_FILES="${PERSONAL_FILES:-$HOME/.personal-files}"
export GOPATH="${GOPATH:-$HOME/go}"
export GOBIN="${GOBIN:-$GOPATH/bin}"

# Zsh's path array is tied to PATH; -U keeps the first occurrence of each entry.
typeset -U path PATH
path=("$HOME/.config/scripts" "$HOME/.local/bin" "$HOME/.opencode/bin" "$GOBIN" $path)
# Support Apple Silicon and Intel Homebrew without starting brew on every pane.
for brew_prefix in /opt/homebrew /usr/local; do
  if [[ -x "$brew_prefix/bin/brew" ]]; then
    path+=("$brew_prefix/bin" "$brew_prefix/sbin")
    [[ -d "$brew_prefix/share/zsh/site-functions" ]] && fpath=("$brew_prefix/share/zsh/site-functions" $fpath)
    [[ -d "$brew_prefix/share/google-cloud-sdk/bin" ]] && path+=("$brew_prefix/share/google-cloud-sdk/bin")
    break
  fi
done
unset brew_prefix
typeset -U fpath

source "$ZSH/exports.zsh"
source "$ZSH/aliases.zsh"

# Keep the existing history location, including on a fresh machine.
[[ -d "$PERSONAL_FILES" ]] || mkdir -p "$PERSONAL_FILES"
setopt HIST_IGNORE_ALL_DUPS HIST_FIND_NO_DUPS

# Initialize completions before plugins. Angular completion loads only on demand.
autoload -Uz compinit
compinit
_ang_completion() {
  unfunction _ang_completion
  if (( $+commands[ng] )); then
    source <(ng completion script)
    local handler=${_comps[ng]:-}
    [[ -n $handler && $handler != _ang_completion ]] && "$handler" "$@"
  fi
}
compdef _ang_completion ng

# Zap is optional on hosts where the plugin manager has not been installed.
if [[ -f "${XDG_DATA_HOME:-$HOME/.local/share}/zap/zap.zsh" ]]; then
  source "${XDG_DATA_HOME:-$HOME/.local/share}/zap/zap.zsh"
  if (( $+functions[plug] )); then
    plug "zsh-users/zsh-autosuggestions"
    plug "zsh-users/zsh-syntax-highlighting"
  fi
fi
source "$ZSH/themes/zsh-highlight-catppuccin.zsh"

# Project runtimes (including JAVA_HOME) come from mise, not a global Java pin.
if (( $+commands[mise] )); then
  eval "$(mise activate zsh)"
fi
export STARSHIP_CONFIG="$HOME/.config/starship/starship.toml"
(( $+commands[starship] )) && eval "$(starship init zsh)"
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"
# Preserve the existing fzf installation; Homebrew fzf is the fallback.
if [[ -f "$HOME/.fzf.zsh" ]]; then
  source "$HOME/.fzf.zsh"
elif (( $+commands[fzf] )); then
  eval "$(fzf --zsh)"
fi
