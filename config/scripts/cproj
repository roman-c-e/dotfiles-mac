#!/bin/zsh
# Open a Git project in cmux. Paths are quoted before becoming shell commands.
emulate -L zsh
setopt pipefail

usage() {
  print -r -- 'Usage: cproj [--new] [--resume] [--park|--cold] [--sync-sidebar] [--agent codex|claude|opencode|COMMAND] [--root PATH] [--list] [--dry-run] [PROJECT]'
  print -r -- 'Without PROJECT, choose a Git repository using fzf. Default root: ~/Developer (overridable in private config).'
  print -r -- 'Focuses an existing project workspace across windows; --new always creates another.'
  print -r -- 'Use --resume to resume a Codex session when a new workspace is created.'
  print -r -- '--sync-sidebar repairs cproj workspace groups and migrates old labels.'
  print -r -- '--park closes the current cproj workspace, keeping its project in a local cold list.'
  print -r -- '--cold picks a parked project and reopens it with the configured resume agent.'
}

# Private settings are optional; no project names or paths belong in this script.
config_file=${CPROJ_CONFIG:-${PERSONAL_FILES:-$HOME/.personal-files}/cproj.json}
settings='{}'
if [[ -f $config_file ]]; then
  settings=$(jq -ce '
    type == "object" and
    ((.root // "") | type == "string") and
    ((.agent // "") | type == "string") and
    ((.resumeAgent // "") | type == "string") and
    ((.groups // []) | type == "array" and all(.[];
      (.path | type == "string" and length > 0) and
      (.name | type == "string" and length > 0) and
      ((.color // "#000000") | type == "string" and test("^#[0-9a-fA-F]{6}$")) and
      ((.root // .path) | type == "string" and length > 0)))
    ' "$config_file") || { print -u2 -- "Invalid cproj config: $config_file"; exit 1; }
  [[ $settings == true ]] || { print -u2 -- "Invalid cproj config: $config_file"; exit 1; }
  settings=$(cat "$config_file")
fi
expand_home() {
  local value=$1
  if [[ $value == '~' ]]; then print -r -- "$HOME"
  elif [[ $value == '~/'* ]]; then print -r -- "$HOME/${value#\~/}"
  else print -r -- "$value"; fi
}
agent=${CPROJ_AGENT:-$(print -r -- "$settings" | jq -r '.agent // "codex"')}
resume_agent=$(print -r -- "$settings" | jq -r '.resumeAgent // "codex resume"')
root=${CPROJ_ROOT:-$(print -r -- "$settings" | jq -r '.root // "~/Developer"')}
root=$(expand_home "$root")
project=''
list_only=0
dry_run=0
force_new=0
sync_sidebar=0
resume=0
park=0
cold=0
agent_option=0
while (( $# )); do
  case "$1" in
    --agent|--root)
      (( $# >= 2 )) || { usage >&2; exit 2; }
      if [[ $1 == --agent ]]; then agent=$2; agent_option=1; else root=$2; fi
      shift 2 ;;
    --list) list_only=1; shift ;;
    --new) force_new=1; shift ;;
    --resume) resume=1; shift ;;
    --park) park=1; shift ;;
    --cold) cold=1; shift ;;
    --sync-sidebar) sync_sidebar=1; shift ;;
    --dry-run) dry_run=1; shift ;;
    -h|--help) usage; exit 0 ;;
    --) shift; (( $# == 1 )) || { usage >&2; exit 2; }; project=$1; shift ;;
    -*) print -u2 -- "Unknown option: $1"; exit 2 ;;
    *) [[ -z $project ]] || { usage >&2; exit 2; }; project=$1; shift ;;
  esac
done

if (( park + cold + sync_sidebar > 1 )); then
  print -u2 -- '--park, --cold, and --sync-sidebar are mutually exclusive.'
  exit 2
fi
if (( park && (dry_run || force_new || list_only || resume || agent_option) )); then
  print -u2 -- '--park cannot be combined with --dry-run, --new, --list, --resume, or --agent.'
  exit 2
fi
if (( cold && (dry_run || force_new) )); then
  print -u2 -- '--cold cannot be combined with --dry-run or --new.'
  exit 2
fi
if (( resume && agent_option )); then
  print -u2 -- '--resume cannot be combined with --agent.'
  exit 2
fi
(( cold && ! agent_option )) && resume=1
(( resume )) && agent=$resume_agent

if (( sync_sidebar && (dry_run || force_new || list_only || resume) )); then
  print -u2 -- '--sync-sidebar cannot be combined with --dry-run, --new, --resume, or --list.'
  exit 2
fi

cold_dir=${XDG_STATE_HOME:-$HOME/.local/state}/cproj/parked
parked_file() {
  local digest
  digest=$(print -rn -- "$1" | shasum -a 256) || return 1
  print -r -- "$cold_dir/${digest%% *}.json"
}
park_project() {
  local directory=$1 id=$2 window=$3 file tmp
  file=$(parked_file "$directory") || return 1
  mkdir -p "$cold_dir" || return 1
  tmp=$(mktemp "$cold_dir/.park.XXXXXXXX") || return 1
  jq -n --arg project "$directory" '{project:$project}' > "$tmp" || return 1
  mv -- "$tmp" "$file" || return 1
  cmux workspace close "$id" --window "$window" || return 1
  print -r -- "Parked: $directory"
}
if (( cold )); then
  parked_files=("$cold_dir"/*.json(N))
  if (( list_only )); then
    (( ${#parked_files} )) && jq -r '.project' "${parked_files[@]}" | sort -u
    exit 0
  fi
  if [[ -z $project ]]; then
    (( ${#parked_files} )) || { print -u2 -- 'No parked projects.'; exit 1; }
    (( $+commands[fzf] )) || { print -u2 'Install fzf with brew install fzf'; exit 1; }
    project=$(jq -r '.project' "${parked_files[@]}" | sort -u | fzf --prompt='Cold project > ' \
      --height=80% --layout=reverse --border --no-multi) || exit 0
  fi
fi

if (( ! sync_sidebar && ! park && ! cold )) && { [[ -z $project ]] || (( list_only )); }; then
  [[ -d $root ]] || { print -u2 -- "Project root does not exist: $root"; exit 1; }
  (( $+commands[fd] )) || { print -u2 'Install fd with brew install fd'; exit 1; }
  # .git can be a directory or a worktree file. Prune matched metadata directories.
  projects=$(fd --hidden --no-ignore --absolute-path --max-depth 8 --prune \
    --exclude node_modules --exclude vendor --exclude target --exclude .venv \
    --exclude build --exclude dist --exclude .gradle --exclude Pods \
    '^\.git$' "$root" | sed -E 's@/\.git/?$@@' | sort -u) || exit 1
  [[ -n $projects ]] || { print -u2 -- "No Git projects found under $root"; exit 1; }
  if (( list_only )); then print -r -- "$projects"; exit 0; fi
  (( $+commands[fzf] )) || { print -u2 'Install fzf with brew install fzf'; exit 1; }
  project=$(print -r -- "$projects" | fzf --prompt='Project > ' \
    --height=80% --layout=reverse --border --no-multi) || exit 0
fi

if (( ! sync_sidebar && ! park )); then
[[ -d $project ]] || { print -u2 -- "Project directory does not exist: $project"; exit 1; }
project=${project:A}
fi
for tool in jq cmux; do
  command -v "$tool" >/dev/null || { print -u2 -- "Required command not found: $tool"; exit 1; }
done

# One atomic record per workspace UUID avoids concurrent launches overwriting
# each other's state. Records survive cmux restarts and are matched only to live IDs.
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/cproj/workspaces
read_registry() {
  local files=("$state_dir"/*.json(N))
  if (( ${#files} )); then
    jq -se 'map({key:.id,value:.project}) | from_entries' "${files[@]}"
  else
    print '{}'
  fi
}
remember_project() {
  local id=$1 directory=$2 tmp
  [[ $id != *[^a-zA-Z0-9-]* && -n $id ]] || return 1
  mkdir -p "$state_dir" || return 1
  tmp=$(mktemp "$state_dir/.record.XXXXXXXX") || return 1
  jq -n --arg id "$id" --arg project "$directory" '{id:$id,project:$project}' > "$tmp" || return 1
  mv -- "$tmp" "$state_dir/$id.json"
}
# Longest directory-prefix match wins. Sibling names are not prefix matches.
project_family() {
  family='' color='' family_root=''
  local entry prefix match_length=0
  while IFS= read -r entry; do
    prefix=$(expand_home "$(print -r -- "$entry" | jq -r '.path')") || return 1
    prefix=${prefix:A}
    if [[ "$1/" == "$prefix/"* ]] && (( ${#prefix} > match_length )); then
      match_length=${#prefix}
      family=$(print -r -- "$entry" | jq -r '.name') || return 1
      color=$(print -r -- "$entry" | jq -r '.color // ""') || return 1
      family_root=$(expand_home "$(print -r -- "$entry" | jq -r '.root // .path')") || return 1
    fi
  done < <(print -r -- "$settings" | jq -c '.groups // [] | .[]')
}
style_workspace() {
  local record=$1 directory=$2 managed=$3
  local id ref window description title groups group family color family_root anchor current_group current_anchor current_color group_color current_group_name
  id=$(print -r -- "$record" | jq -er '.id') || return 1
  ref=$(print -r -- "$record" | jq -er '.ref // .id') || return 1
  window=$(print -r -- "$record" | jq -er '.cproj_window') || return 1
  description=$(print -r -- "$record" | jq -r '.description // ""') || return 1
  if [[ $managed == yes ]]; then
    # Save identity before removing its old visible representation.
    remember_project "$id" "$directory" || return 1
    title=$(print -r -- "$record" | jq -r --arg fallback "${directory:t}" '.custom_title // .title // $fallback') || return 1
    if [[ $title != '⌘ '* ]]; then
      cmux workspace-action --action rename --workspace "$id" --window "$window" --title "⌘ $title" >/dev/null || return 1
    fi
    if [[ $description == '⌘' || $description == cproj:/* ]]; then
      cmux workspace-action --action clear-description --workspace "$id" --window "$window" >/dev/null || return 1
    fi
  fi
  groups=$(cmux --json workspace-group list --window "$window") || return 1
  current_group=$(print -r -- "$groups" | jq -r --arg ref "$ref" '.groups[] | select(.member_workspace_refs | index($ref) != null) | .ref' | head -n 1) || return 1
  current_anchor=$(print -r -- "$groups" | jq -r --arg group "$current_group" '.groups[] | select(.ref==$group) | .anchor_workspace_ref') || return 1
  current_color=$(print -r -- "$record" | jq -r '.custom_color // ""' | tr '[:upper:]' '[:lower:]') || return 1
  if [[ $managed != yes ]]; then
    # Earlier versions colored generated group anchors too. Clear only the
    # matching family color; leave every other unowned workspace untouched.
    if [[ -n $current_group && $ref == $current_anchor && -n $current_color ]]; then
      current_group_name=$(print -r -- "$groups" | jq -r --arg group "$current_group" '.groups[] | select(.ref==$group) | .name') || return 1
      if print -r -- "$settings" | jq -e --arg name "$current_group_name" --arg color "$current_color" '[.groups[]? | select(.name==$name) | .color? | ascii_downcase] | index($color) != null' >/dev/null; then
        cmux workspace-action --action clear-color --workspace "$id" --window "$window" >/dev/null || return 1
      fi
    fi
    return 0
  fi
  project_family "$directory" || return 1
  group=$(print -r -- "$groups" | jq -r --arg name "$family" '.groups[] | select(.name==$name) | .ref' | head -n 1) || return 1
  if [[ -n $current_group && $current_group != $group ]]; then
    if [[ $ref == $current_anchor ]]; then
      print -u2 -- "Cannot move group anchor $ref automatically; move its group header manually."
      return 1
    fi
    cmux workspace-group remove --window "$window" --workspace "$id" >/dev/null || return 1
  fi
  # Clear only colors from the former family palette; preserve user-assigned
  # attention colors and notification indicators.
  if [[ -n $current_color ]] && print -r -- "$settings" | jq -e --arg color "$current_color" '[.groups[]?.color? | ascii_downcase] | index($color) != null' >/dev/null; then
    cmux workspace-action --action clear-color --workspace "$id" --window "$window" >/dev/null || return 1
  fi
  [[ -n $family ]] || return 0
  if [[ -z $group ]]; then
    group=$(cmux --json workspace-group create --window "$window" --name "$family" --cwd "$family_root" --from "$id" | jq -er '.group.ref') || return 1
  elif [[ $current_group != $group ]]; then
    cmux workspace-group add --window "$window" --group "$group" --workspace "$id" >/dev/null || return 1
  fi
  group_color=$(print -r -- "$groups" | jq -r --arg group "$group" '.groups[] | select(.ref==$group) | .custom_color // ""' | tr '[:upper:]' '[:lower:]') || return 1
  if [[ -n $color && $group_color == ${color:l} ]]; then
    cmux workspace-group set-color "$group" --window "$window" >/dev/null || return 1
  fi
  cmux workspace-group set-icon "$group" --window "$window" --symbol folder.fill >/dev/null || return 1
  if [[ ${4:-} == top ]]; then
    groups=$(cmux --json workspace-group list --window "$window") || return 1
    anchor=$(print -r -- "$groups" | jq -er --arg group "$group" '.groups[] | select(.ref==$group) | .anchor_workspace_ref') || return 1
    [[ $ref == $anchor ]] || cmux reorder-workspace --workspace "$id" --window "$window" --after "$anchor" >/dev/null || return 1
  fi
  return 0
}

registry=$(read_registry) || exit 1
if (( park )); then
  if [[ -z $project ]]; then
    current=$(cmux --json current-workspace) || exit 1
    workspace=$(print -r -- "$current" | jq -er '.workspace.id') || exit 1
    window=$(print -r -- "$current" | jq -er '.window_ref') || exit 1
    project=$(print -r -- "$current" | jq -r --argjson saved "$registry" \
      '$saved[.workspace.id] // (if (.workspace.description // "" | startswith("cproj:/")) then .workspace.description[6:] else "" end)') || exit 1
    [[ -n $project ]] || { print -u2 -- 'Current workspace is not managed by cproj.'; exit 1; }
    [[ -d $project ]] || { print -u2 -- "Project directory does not exist: $project"; exit 1; }
    park_project "$project" "$workspace" "$window"
    exit $?
  fi
  [[ -d $project ]] || { print -u2 -- "Project directory does not exist: $project"; exit 1; }
  project=${project:A}
fi
project_marker="cproj:$project"
if (( sync_sidebar || (! force_new && ! dry_run) )); then
  tree=$(cmux --json tree --all) || exit 1
  windows=$(print -r -- "$tree" | jq -er '.windows | map(.ref) | .[]') || {
    print -u2 'Could not read cmux windows; refusing to create a duplicate.'
    exit 1
  }
  workspace_data='[]'
  for window in ${(f)windows}; do
    response=$(cmux --json list-workspaces --window "$window") || exit 1
    entries=$(print -r -- "$response" | jq -ce --arg window "$window" '
      .workspaces | map(. + {cproj_window: $window})') || exit 1
    workspace_data=$(jq -nc --argjson old "$workspace_data" --argjson entries "$entries" \
      '$old + $entries') || exit 1
  done
  if (( sync_sidebar )); then
    while IFS= read -r record; do
      directory=$(print -r -- "$record" | jq -r --argjson saved "$registry" '$saved[.id] // (if (.description // "" | startswith("cproj:/")) then .description[6:] else .current_directory end)') || exit 1
      managed=$(print -r -- "$record" | jq -r --argjson saved "$registry" 'if $saved[.id] != null or (.description // "" | startswith("cproj:/")) then "yes" else "no" end') || exit 1
      style_workspace "$record" "$directory" "$managed" || exit 1
    done < <(print -r -- "$workspace_data" | jq -c '.[] | select(.remote.enabled != true)')
    selected=$(print -r -- "$workspace_data" | jq -c '.[] | select(.selected)')
    for record in ${(f)selected}; do
      cmux select-workspace --workspace "$(print -r -- "$record" | jq -r .id)" --window "$(print -r -- "$record" | jq -r .cproj_window)" >/dev/null || exit 1
    done
    print 'Sidebar synchronized.'
    exit 0
  fi
  existing=$(print -r -- "$workspace_data" | jq -c --arg marker "$project_marker" --arg cwd "$project" --argjson saved "$registry" '
    [.[] | select(.remote.enabled != true) |
      select($saved[.id] == $cwd or .description == $marker or
        ($saved[.id] == null and (.description == null or .description == "") and .current_directory == $cwd))]
    | sort_by([if $saved[.id] == $cwd or .description == $marker then 0 else 1 end,
               if .has_custom_title then 0 else 1 end,
               if .selected then 0 else 1 end])
    | .[0] // empty') || exit 1
  if [[ -n $existing ]]; then
    workspace=$(print -r -- "$existing" | jq -er '.id') || exit 1
    window=$(print -r -- "$existing" | jq -er '.cproj_window') || exit 1
    if (( park )); then
      park_project "$project" "$workspace" "$window"
      exit $?
    fi
    style_workspace "$existing" "$project" yes || exit 1
    cmux select-workspace --workspace "$workspace" --window "$window" || exit 1
    cmux focus-window --window "$window" || exit 1
    if (( cold )); then rm -f -- "$(parked_file "$project")" || exit 1; fi
    exit 0
  fi
fi

if (( park )); then
  print -u2 -- "No open cproj workspace found for: $project"
  exit 1
fi

# Reusing a workspace does not require the original agent/editor on PATH.
# Split shell-style quoted arguments, then quote each word again for execution.
# Do not evaluate substitutions, pipelines, or other shell code in --agent.
agent_words=(${(z)agent})
agent_words=("${(@Q)agent_words}")
(( ${#agent_words} )) || { print -u2 'Agent command must not be empty.'; exit 2; }
for tool in nvim "${agent_words[1]}"; do
  command -v "$tool" >/dev/null || { print -u2 -- "Required command not found: $tool"; exit 1; }
done

# Each pane changes directory explicitly; a failed cd never launches the tool.
agent_command="cd -- ${(q)project} && ${(j: :)${(@q)agent_words}}"
editor_command="cd -- ${(q)project} && nvim"
shell_command="cd -- ${(q)project}"
layout=$(jq -nc --arg agent "$agent_command" --arg editor "$editor_command" \
  --arg shell "$shell_command" --arg agent_name "$agent" '
  {direction:"horizontal", split:0.5, children:[
    {pane:{surfaces:[{type:"terminal",name:$agent_name,command:$agent,focus:true}]}},
    {direction:"vertical",split:0.7,children:[
      {pane:{surfaces:[{type:"terminal",name:"Editor",command:$editor}]}},
      {pane:{surfaces:[{type:"terminal",name:"Build / test",command:$shell}]}}
    ]}
  ]}') || exit 1

# Optional private layout uses the cmux layout schema with exact command tokens.
# Commands are expanded only after project paths and agent arguments are quoted.
if print -r -- "$settings" | jq -e '.layout != null' >/dev/null; then
  layout=$(print -r -- "$settings" | jq -ce --arg agent "$agent_command" \
    --arg editor "$editor_command" --arg shell "$shell_command" \
    --arg git "$shell_command && lazygit" '
    .layout | if type != "object" then error("layout must be an object") else . end |
    walk(if type == "object" and has("command") then
      .command = ({"{{agent}}":$agent,"{{editor}}":$editor,
                   "{{shell}}":$shell,"{{git}}":$git}[.command] // .command)
    else . end)') || exit 1
fi

if (( dry_run )); then
  jq -n --arg name "${project:t}" --arg cwd "$project" --argjson layout "$layout" \
    '{name:$name,cwd:$cwd,layout:$layout}'
  exit $?
fi
created=$(cmux --json workspace create --name "${project:t}" --description "$project_marker" \
  --cwd "$project" --layout "$layout" --focus true) || exit 1
workspace_ref=$(print -r -- "$created" | jq -er '.workspace_ref') || exit 1
window=$(print -r -- "$created" | jq -er '.window_ref') || exit 1
record=$(cmux --json list-workspaces --window "$window" | jq -ce \
  --arg ref "$workspace_ref" --arg window "$window" \
  '.workspaces[] | select(.ref==$ref) | . + {cproj_window:$window}') || exit 1
workspace=$(print -r -- "$record" | jq -er '.id') || exit 1
style_workspace "$record" "$project" yes top || exit 1
cmux select-workspace --workspace "$workspace" --window "$window" || exit 1
if (( cold )); then rm -f -- "$(parked_file "$project")" || exit 1; fi
