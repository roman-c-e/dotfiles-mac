# macOS desktop additions. Install after the root Brewfile.

# Terminal and fonts
cask "cmux"
cask "font-jetbrains-mono"
cask "font-fira-code"
cask "font-meslo-lg-nerd-font"
cask "font-hack-nerd-font"

# Development desktop (OrbStack matches the current machine)
cask "orbstack"
cask "chatgpt"

# Mac enhancements and remote display client
cask "alfred"
cask "karabiner-elements"
cask "moonlight"
brew "mas"
# Requires an App Store account with access to these apps.
mas "Magnet", id: 441258766

# Productivity and communication
cask "vivaldi"
cask "obsidian"
cask "microsoft-excel"
cask "microsoft-word"
cask "microsoft-outlook"
cask "microsoft-teams"
cask "slack"
cask "discord"

# Media and documents from the existing installer
cask "jdownloader"
cask "vlc"
cask "spotify"
# Disabled by Homebrew on 2026-09-01 (Gatekeeper check); revisit separately.
# cask "comictagger"
cask "calibre"
cask "obs"
cask "mactex-no-gui"
# Disabled by Homebrew on 2026-09-01 (Gatekeeper check); revisit separately.
