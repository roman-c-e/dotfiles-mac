# Optional infrastructure tools. No services are started automatically.
tap "hashicorp/tap"
tap "azure/kubelogin"

brew "hashicorp/tap/terraform"
brew "hashicorp/tap/packer"
brew "opentofu"
brew "ansible"
brew "hcloud"
brew "kubernetes-cli"
brew "talosctl"
brew "azure/kubelogin/kubelogin"
brew "kind"
brew "cilium-cli"
brew "helm"
brew "flux"
brew "age"
brew "sops"
brew "cosign"

# The Google Cloud SDK cask makes this profile macOS-specific.
cask "gcloud-cli"
