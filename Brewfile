# Shared CLI tools for a workstation or remote development host.
# Install with: brew bundle install --file=Brewfile --no-upgrade
# Project runtime versions belong in each project's mise.toml.

# Shell, navigation, and inspection
brew "bash"
brew "coreutils"
brew "starship"
brew "zoxide"
brew "fzf"
brew "fd"
brew "ripgrep"
brew "bat"
brew "lsd"
brew "tree"
brew "jq"
brew "jless"
brew "wget"
brew "yazi"

# Editing and Git (Neovim configuration is managed separately)
brew "neovim"
brew "tree-sitter-cli"
brew "python-lsp-server"
brew "git"
brew "gh"
brew "git-filter-repo"
brew "lazygit"

# Runtime management and project tooling
brew "mise"
brew "uv"
brew "ruff"
brew "just"
brew "act"
brew "protobuf"
brew "grpc"
brew "grpcurl"

# Optional remote transports/session persistence used from cmux or plain SSH
brew "tmux"
brew "mosh"

# File previews and archives, also used by Yazi
brew "imagemagick"
brew "poppler"
brew "ffmpeg"
brew "sevenzip"
